@page "/categories"
@inject HttpClient Http

<PageTitle>Categories - SmartLibrary</PageTitle>

<div class="smartlibrary-app">

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="nav-container">
            <a class="brand" href="/"><img src="logo.png" alt="Logo" style="width:70px; height:60px; margin-right:-2px; border-radius:6px; vertical-align:middle;" />SmartLibrary</a>
            <div class="nav-links">
                <a class="nav-link" href="/">Home</a>
                <a class="nav-link" href="/books">Books</a>
                <a class="nav-link" href="/authors">Authors</a>
                <a class="nav-link active" href="/categories">Categories</a>
                <a class="nav-link" href="/members">Members</a>
                <a class="nav-link" href="/borrowrecords">Borrow Records</a>
            </div>
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    <div class="page-content">
        <div class="content-wrapper">

            <!-- Header -->
            <div class="page-header">
                <div>
                    <h1 class="page-title">Categories</h1>
                    <p class="page-subtitle">Manage book categories</p>
                </div>
                <button class="add-btn" @onclick="ShowAddForm">
                    + Add New Category
                </button>
            </div>

            <!-- Alert -->
            @if (!string.IsNullOrEmpty(alertMessage))
            {
                <div class="alert @alertClass">
                    @alertMessage
                    <button class="alert-close" @onclick="() => alertMessage = string.Empty">×</button>
                </div>
            }

            <!-- Add/Edit Form -->
            @if (showForm)
            {
                <div class="form-card">
                    <div class="form-header">
                        <h3>@(editingCategory.Id == 0 ? "Add New Category" : "Edit Category")</h3>
                        <button class="form-close" @onclick="CancelForm">×</button>
                    </div>
                    <div class="form-body">
                        <div class="form-grid categories-form-grid">
                            <div class="form-group">
                                <label>Name *</label>
                                <input class="form-input" @bind="editingCategory.Name" />
                            </div>
                            <div class="form-group">
                                <label>Description</label>
                                <input class="form-input" @bind="editingCategory.Description" />
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="save-btn" @onclick="SaveCategory">
                                @(editingCategory.Id == 0 ? "Save Category" : "Update Category")
                            </button>
                            <button class="cancel-btn" @onclick="CancelForm">Cancel</button>
                        </div>
                    </div>
                </div>
            }

            <!-- Table -->
            <div class="table-card">
                @if (categories == null)
                {
                    <div class="loading">
                        <div class="spinner"></div>
                    </div>
                }
                else if (!categories.Any())
                {
                    <div class="empty-state">
                        <i class="ri-folder-line"></i>
                        <p>No categories found.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>NAME</th>
                                    <th>DESCRIPTION</th>
                                    <th>ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in categories)
                                {
                                    <tr>
                                        <td class="td-id">@category.Id</td>
                                        <td class="td-title">@category.Name</td>
                                        <td class="td-author">@category.Description</td>
                                        <td>
                                            <div class="action-btns">
                                                <button class="edit-btn"
                                                        @onclick="() => EditCategory(category)">
                                                    Edit
                                                </button>
                                                <button class="delete-btn @(deleteConfirmId == category.Id ? "confirm" : "")"
                                                        @onclick="() => DeleteCategory(category.Id)">
                                                    @(deleteConfirmId == category.Id ? "Confirm?" : "Delete")
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-top">
            <div class="footer-left">
                <h2>Expand Your<br />Knowledge</h2>
                <p>SmartLibrary empowers communities to discover, borrow, and manage books effortlessly.</p>
            </div>
            <div class="footer-right">
                <div class="footer-column">
                    <h3>RESOURCES</h3>
                    <a href="/books">Books Catalog</a>
                    <a href="/authors">Authors Index</a>
                    <a href="/categories">Categories</a>
                </div>
                <div class="footer-column">
                    <h3>MANAGEMENT</h3>
                    <a href="/members">Members</a>
                    <a href="/borrowrecords">Borrow Records</a>
                    <a href="#">Dashboard</a>
                </div>
                <div class="footer-column">
                    <h3>SUPPORT</h3>
                    <a href="#">Help Center</a>
                    <a href="#">Documentation</a>
                    <a href="#">Contact Us</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 SmartLibrary. All rights reserved.</p>
            <div class="footer-links">
                <span>Privacy Policy</span>
                <span>Terms of Service</span>
            </div>
        </div>
    </footer>

</div>

@code {
    private List<Category>? categories;
    private Category editingCategory = new Category();
    private bool showForm = false;
    private string alertMessage = "";
    private string alertClass = "";
    private int? deleteConfirmId = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<List<Category>>("api/categories");
        }
        catch (Exception ex)
        {
            ShowAlert($"Error loading categories: {ex.Message}", "alert-error");
        }
    }

    private void ShowAddForm()
    {
        editingCategory = new Category();
        showForm = true;
        alertMessage = "";
    }

    private void EditCategory(Category category)
    {
        editingCategory = new Category
        {
            Id = category.Id,
            Name = category.Name,
            Description = category.Description
        };
        showForm = true;
        alertMessage = "";
    }

    private async Task SaveCategory()
    {
        try
        {
            HttpResponseMessage response;
            if (editingCategory.Id == 0)
                response = await Http.PostAsJsonAsync("api/categories", editingCategory);
            else
                response = await Http.PutAsJsonAsync(
                    $"api/categories/{editingCategory.Id}", editingCategory);

            response.EnsureSuccessStatusCode();

            showForm = false;
            ShowAlert(editingCategory.Id == 0 ?
                "Category added successfully." : "Category updated successfully.", "alert-success");
            await LoadCategories();
        }
        catch (Exception ex)
        {
            ShowAlert($"Error saving: {ex.Message}", "alert-error");
        }
    }

    private async Task DeleteCategory(int id)
    {
        if (deleteConfirmId == id)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/categories/{id}");
                response.EnsureSuccessStatusCode();
                deleteConfirmId = null;
                ShowAlert("Category deleted successfully.", "alert-success");
                await LoadCategories();
            }
            catch (Exception ex)
            {
                ShowAlert($"Error deleting: {ex.Message}", "alert-error");
            }
        }
        else
        {
            deleteConfirmId = id;
        }
    }

    private void CancelForm()
    {
        showForm = false;
        alertMessage = "";
    }

    private void ShowAlert(string message, string cssClass)
    {
        alertMessage = message;
        alertClass = cssClass;
    }

    public class Category
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}