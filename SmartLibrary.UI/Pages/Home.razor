@inject HttpClient Http
@page "/"

@code {
    private AnalyticsDto? analytics;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            analytics = await Http.GetFromJsonAsync<AnalyticsDto>("api/analytics");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    public class AnalyticsDto
    {
        public int TotalBooks { get; set; }
        public int AvailableBooks { get; set; }
        public int MembersCount { get; set; }
        public int ActiveBorrows { get; set; }
    }
}



<PageTitle>SmartLibrary</PageTitle>

<link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet">

<div class="smartlibrary-app">

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="nav-container">

            <a class="brand" href="/"><img src="logo.png" alt="Logo" style="width:70px; height:60px; margin-right:-2px; border-radius:6px; vertical-align:middle;" />SmartLibrary</a>

            <div class="nav-links">
                <a class="nav-link active" href="/">Home</a>
                <a class="nav-link" href="/books">Books</a>
                <a class="nav-link" href="/authors">Authors</a>
                <a class="nav-link" href="/categories">Categories</a>
                <a class="nav-link" href="/members">Members</a>
                <a class="nav-link" href="/borrowrecords">Borrow Records</a>
            </div>

            <button class="mobile-menu">
                <i class="ri-menu-line"></i>
            </button>

        </div>
    </nav>

    <!-- HERO -->
    <section class="hero-section">

        <div class="hero-overlay"></div>

        <img class="hero-image"
             src="https://public.readdy.ai/ai/img_res/be61a5690374368ff39b38c2ca0ffe16.jpg"
             alt="Library" />

        <div class="hero-content">

            <div class="hero-text">
                <h1>Welcome to <span style="color:#51917d;">SmartLibrary</span></h1>

                <p>
                    Your all-in-one library management platform. Track books, manage members,
                    monitor borrows, and grow your community seamlessly.
                </p>
            </div>

            <!-- STATS -->
            <div class="stats-grid">

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="icon-box">
                            <i class="ri-book-3-line"></i>
                        </div>

                        <span>Total Books</span>
                    </div>

                    @* <h2>69</h2> *@
                    <h2>@(analytics != null ? analytics.TotalBooks.ToString() : "...")</h2>
                    <p>Copies in collection</p>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="icon-box">
                            <i class="ri-book-open-line"></i>
                        </div>

                        <span>Available</span>
                    </div>

                    @* <h2>32</h2> *@
                    <h2>@(analytics != null ? analytics.AvailableBooks.ToString() : "...")</h2>
                    <p>Ready to borrow</p>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="icon-box">
                            <i class="ri-user-3-line"></i>
                        </div>

                        <span>Members</span>
                    </div>

                    @* <h2>8</h2> *@
                    <h2>@(analytics != null ? analytics.MembersCount.ToString() : "...")</h2>

                    <p>Registered readers</p>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="icon-box">
                            <i class="ri-exchange-line"></i>
                        </div>

                        <span>Active Borrows</span>
                    </div>

                    @* <h2>4</h2> *@
                    <h2>@(analytics != null ? analytics.ActiveBorrows.ToString() : "...")</h2>

                    <p>Currently on loan</p>
                </div>

            </div>

            <!-- BUTTONS -->
            <div class="hero-buttons">

                <a href="/books" class="primary-btn">
                    Explore Catalog
                </a>

                <a href="/borrowrecords" class="secondary-link">
                    View Borrow Records
                </a>

            </div>

        </div>

    </section>

    <!-- QUICK ACTIONS -->
    <section class="actions-section">

        <div class="section-header">

            <span>DASHBOARD</span>

            <h2>Quick Actions</h2>

            <p>
                Manage every aspect of your library from a single, intuitive dashboard.
            </p>

        </div>

        <div class="actions-grid">

            <div class="action-card">

                <div class="action-icon">
                    <i class="ri-book-3-line"></i>
                </div>

                <h3>Manage Books</h3>

                <p>
                    Add, edit, and organize your complete book catalog with ease.
                </p>

                <a href="/books">
                    View Books
                    <i class="ri-arrow-right-line"></i>
                </a>

            </div>

            <div class="action-card">

                <div class="action-icon">
                    <i class="ri-user-3-line"></i>
                </div>

                <h3>Member Portal</h3>

                <p>
                    Track memberships, borrow history, and member activities.
                </p>

                <a href="/members">
                    View Members
                    <i class="ri-arrow-right-line"></i>
                </a>

            </div>

            <div class="action-card">

                <div class="action-icon">
                    <i class="ri-file-list-3-line"></i>
                </div>

                <h3>Borrow Records</h3>

                <p>
                    Monitor active loans, overdue items, and returns in real-time.
                </p>

                <a href="/borrowrecords">
                    View Records
                    <i class="ri-arrow-right-line"></i>
                </a>

            </div>

            <div class="action-card">

                <div class="action-icon">
                    <i class="ri-bar-chart-line"></i>
                </div>

                <h3>Analytics</h3>

                <p>
                    Gain insights into library usage, popular titles, and trends.
                </p>

                <a href="/">
                    View Analytics
                    <i class="ri-arrow-right-line"></i>
                </a>

            </div>

        </div>

    </section>

    <!-- BANNER -->
    <section class="banner-section">

        <img src="https://public.readdy.ai/ai/img_res/f1ecc0d35f620aea4cc4beb9d8703e4c.jpg"
             alt="Library Interior"
             class="banner-image" />

        <div class="banner-overlay"></div>

        <div class="banner-content">

            <div class="banner-title">
                <h2>
                    EXPAND YOUR<br />
                    KNOWLEDGE
                </h2>
            </div>

            <div class="banner-bottom">

                <a href="/books" class="banner-btn">

                    <span>Browse Collection</span>

                    <div class="circle-btn">
                        <i class="ri-arrow-right-line"></i>
                    </div>

                </a>

                <p>
                    Discover thousands of titles, from timeless classics<br />
                    to modern bestsellers, all at your fingertips.
                </p>

            </div>

        </div>

    </section>

    <!-- FOOTER -->
    <footer class="footer">

        <div class="footer-top">

            <div class="footer-left">

                <h2>
                    EXPAND YOUR<br />
                    KNOWLEDGE
                </h2>

                <p>
                    SmartLibrary empowers communities to discover, borrow,
                    and manage books effortlessly. Join thousands of readers
                    and librarians who trust our platform every day.
                </p>

            </div>

            <div class="footer-right">

                <div class="footer-column">

                    <h3>Resources</h3>

                    <a href="/books">Books Catalog</a>
                    <a href="/authors">Authors Index</a>
                    <a href="/categories">Categories</a>

                </div>

                <div class="footer-column">

                    <h3>Management</h3>

                    <a href="/members">Members</a>
                    <a href="/borrowrecords">Borrow Records</a>
                    <a href="/">Dashboard</a>

                </div>

                <div class="footer-column">

                    <h3>Support</h3>

                    <a href="/">Help Center</a>
                    <a href="/">Documentation</a>
                    <a href="/">Contact Us</a>

                </div>

            </div>

        </div>

        <div class="footer-bottom">

            <p>© 2026 SmartLibrary. All rights reserved.</p>

            <div class="footer-links">
                <span>Privacy Policy</span>
                <span>Terms of Service</span>
            </div>

        </div>

    </footer>

</div>



